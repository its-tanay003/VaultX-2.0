{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valutx.dev/schemas/v1/evidence.json",
  "title": "Evidence",
  "description": "Cryptographically verifiable bundle of proof recording execution outputs and side effects",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "run_id",
    "action_id",
    "sha256",
    "artifacts",
    "timestamp"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "action_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "maxItems": 1000
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    }
  }
}
