{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valutx.dev/schemas/v1/verification.json",
  "title": "VerificationResult",
  "description": "Deterministic post-execution verification outcome for code and state mutations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "run_id",
    "status",
    "checks",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "FAILED"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed",
          "duration_ms"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "passed": {
            "type": "boolean"
          },
          "output": {
            "type": "string",
            "maxLength": 10000
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "maxItems": 100
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    }
  }
}
