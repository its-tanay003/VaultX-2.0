{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valutx.dev/schemas/v1/benchmark-result.json",
  "title": "BenchmarkResult",
  "description": "Schema for VaultX-Bench task execution outcome and governance metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "task_id",
    "benchmark_version",
    "success",
    "verified",
    "policy_denials",
    "blocks",
    "rollback_ok",
    "approvals_count",
    "wall_time_ms",
    "cost_usd",
    "created_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "success": {
      "type": "boolean"
    },
    "verified": {
      "type": "boolean"
    },
    "policy_denials": {
      "type": "integer",
      "minimum": 0
    },
    "blocks": {
      "type": "integer",
      "minimum": 0
    },
    "rollback_ok": {
      "type": "boolean"
    },
    "approvals_count": {
      "type": "integer",
      "minimum": 0
    },
    "wall_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    },
    "error": {
      "type": "string",
      "maxLength": 1000
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
